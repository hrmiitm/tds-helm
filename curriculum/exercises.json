{
  "$schema": "https://rag-studio.local/schemas/exercises-manifest.json",
  "version": "4.0.0",
  "course": "agent-rag-learning",
  "exercises": {
    "module_01_lexical_vs_semantic": {
      "exerciseId": "lexical-vs-semantic",
      "query": "distributed workforce policies",
      "policy_corpus": [
        "Policy_01_RemoteWork.txt",
        "Policy_02_Security.txt",
        "Policy_03_Expenses.txt"
      ],
      "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
      "expected_lexical_matches": 0,
      "expected_rank_1_document": "Policy_01_RemoteWork.txt"
    },
    "module_02_chunking": {
      "exerciseId": "chunking-strategies",
      "canonical_document": "doc_001.txt",
      "chunk_size": 350,
      "chunk_overlap": 50,
      "length_function": "len",
      "separators": ["\n\n", "\n", ". ", " ", ""],
      "strip_whitespace": true,
      "expected_canonical_chunks": 12,
      "alternate_experiments": {
        "exp_300_30": {
          "chunk_size": 300,
          "chunk_overlap": 30,
          "expected_chunks": 14
        },
        "exp_250_40": {
          "chunk_size": 250,
          "chunk_overlap": 40,
          "expected_chunks": 17
        }
      }
    },
    "module_03_embeddings": {
      "exerciseId": "embeddings-vector-math",
      "model_id": "sentence-transformers/all-MiniLM-L6-v2",
      "dimensions": 384,
      "device": "cpu",
      "normalization": true,
      "sample_sentences": [
        "Retrieval-Augmented Generation grounds AI answers with verified facts.",
        "RAG systems search a vector database to provide context for LLMs.",
        "Baking traditional sourdough bread requires wild yeast and hydration."
      ],
      "pairs": {
        "related": [0, 1],
        "distractor": [0, 2]
      }
    },
    "module_04_chromadb": {
      "exerciseId": "vector-store-ops",
      "collection_name": "rag_knowledge_base",
      "distance_space": "cosine",
      "canonical_corpus": [
        "doc_001.txt",
        "doc_002.txt",
        "doc_003.txt"
      ],
      "expected_total_indexed_chunks": 37,
      "query": "How does HNSW use skip lists and layers to navigate high-dimensional space?",
      "top_k": 2,
      "expected_top_source": "doc_003.txt"
    },
    "module_05_rag_pipeline": {
      "exerciseId": "grounded-rag-pipeline",
      "question": "What is the computational complexity of exact k-NN compared to approximate search?",
      "top_k": 2,
      "grounding_prompt_header": "You are a specialized AI technical assistant. Answer the user's question using ONLY the verified context below.",
      "required_citations": true
    },
    "module_06_api_preview": {
      "exerciseId": "api-preview-deployment",
      "service_host": "127.0.0.1",
      "service_port": 8000,
      "gateway_prefix": "/preview/8000",
      "endpoints": {
        "health": "/health",
        "query": "/query",
        "docs": "/docs",
        "openapi": "/openapi.json"
      },
      "test_query": "How does HNSW use skip lists and layers to navigate high-dimensional space?"
    }
  }
}
