{
  "name": "studio-universal-desktop",
  "version": "4.2.0",
  "description": "Studio Universal Multi-Chapter Native Desktop Client & Controller",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:no-sandbox": "electron . --no-sandbox",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Google DeepMind / Studio Universal Team",
  "license": "Apache-2.0",
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ragstudio.app",
    "productName": "RAG Studio",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.education"
    },
    "win": {
      "target": ["nsis"]
    }
  }
}

